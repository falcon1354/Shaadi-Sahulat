# ─────────────────────────────────────────────
#  ShaadiSahulat — Environment Variables (example)
#  Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────

PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/shaadi-sahulat

# ── Authentication (JWT) ─────────────────────────
# Each developer generates their OWN secrets locally (never commit them):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The backend refuses to start if JWT_ACCESS_SECRET (>= 32 chars),
# INTERNAL_API_SECRET or FRONTEND_ORIGIN is missing.
JWT_ACCESS_SECRET=
INTERNAL_API_SECRET=
FRONTEND_ORIGIN=http://localhost:3000
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
REFRESH_ABSOLUTE_DAYS=30
BCRYPT_ROUNDS=12
# ── Email (password reset + email verification) ──
# EMAIL_TRANSPORT (required — there is no default and no fallback between modes):
#   console  = development only: each email is written as an .eml file to MAIL_OUTBOX_DIR
#              (default ./.mail-outbox, git-ignored) and is NOT delivered to any inbox.
#   smtp     = real delivery via the SMTP_* settings below. If they are missing or wrong the
#              email FAILS (logged with a safe reason); it is never written to the outbox instead.
#   disabled = drop all mail. Automated tests never send real email.
# The backend prints the result at startup: "SMTP authentication successful",
# "SMTP authentication failed", "Missing SMTP configuration" or "Console transport - NOT delivered".
EMAIL_TRANSPORT=console
MAIL_OUTBOX_DIR=
# SMTP (only when EMAIL_TRANSPORT=smtp). Placeholders only — never commit real credentials.
#   Port 465 → SMTP_SECURE=true (implicit TLS); port 587 → SMTP_SECURE=false (STARTTLS, enforced).
#   (For 465/587 the port decides the mode even if SMTP_SECURE is set wrongly.)
#   SMTP_FROM defaults to SMTP_USER when empty.
#   Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=<your Gmail address>, SMTP_PASSWORD=<16-char
#   Google App Password> (Google Account → Security → 2-Step Verification → App passwords;
#   a normal Gmail password will not work), SMTP_FROM should use the same Gmail address.
#   Check the setup with:  node scripts/send-test-email.js you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ShaadiSahulat <no-reply@example.com>
# Sign-up is OTP-first: a 6-digit code (valid 10 min, 5 attempts, 60 s resend cooldown) is
# emailed and the buyer/seller account is only created after it is verified.
# One-time link lifetimes (reset: 5–120 min, verification: 1–168 h).
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFY_TTL_HOURS=24
# The SRS does not require a verified email before login, so verification is tracked
# but not enforced. Set to true to block unverified buyers/sellers at login
# (403 EMAIL_NOT_VERIFIED). Admins are never affected.
EMAIL_VERIFICATION_REQUIRED=false
# Admin seeding (seeds/seedAdmin.js, scripts/fix-demo-logins.js). Leave blank to be
# prompted in a terminal. Never commit real values. There is NO admin sign-up.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=
# Optional: demo buyer password for scripts/fix-demo-logins.js
DEMO_BUYER_PASSWORD=
# Bank officer portal (BNPL review). No credentials are hardcoded: set the email and a
# bcrypt hash of the password (never the plain password):
#   node scripts/hash-bank-officer-password.js
# Login answers 503 until both are set.
BANK_OFFICER_EMAIL=
BANK_OFFICER_PASSWORD_HASH=
# Lifetime of signed links to private files (CNIC docs, dispute evidence), seconds.
PRIVATE_FILE_URL_TTL_SECONDS=600
# Internal Python services listen on localhost only and require INTERNAL_API_SECRET
# (sent automatically by the Node backend). Never enable the Werkzeug debugger on a
# reachable host: it allows remote code execution.
VISUAL_ML_HOST=127.0.0.1
ML_SERVICE_HOST=127.0.0.1
FLASK_DEBUG=false

ML_SERVICE_URL=http://localhost:5001
VISUAL_ML_URL=http://localhost:5002

# Tone-aware review TTS (Kokoro) — npm run dev:tone
TONE_VOICE_URL=http://127.0.0.1:8000
REVIEW_TTS_ENABLED=true
# TONE_VOICE_TIMEOUT_MS=120000

BNPL_CRYPTO_KEY=replace_with_64_hex_chars

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cloudinary (products, categories, BNPL, disputes, banners)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Size-aware try-on: local | kling_omni | kling_vton | fal
# kling_omni uses Image Generation package (person + dress + prompt)
TRYON_PROVIDER=kling_omni
KLING_API_KEY=
# Or official Kling Open Platform JWT credentials:
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=
KLING_API_BASE=https://api.klingai.com
KLING_OMNI_MODEL=kling-image-o1
KLING_IMAGE_MODE=omni
# KLING_TRYON_PROMPT=
KLING_VTON_MODEL=kolors-virtual-try-on-v1-5
FAL_KEY=
